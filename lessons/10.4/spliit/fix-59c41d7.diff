 })
+
+// groupFormSchema is the only check on a group name: the group form, the
+// create procedure and the update (edit) procedure all validate against it.
+describe('groupFormSchema, group name', () => {
+  function nameIssues(name: string): string[] {
+    const result = groupFormSchema.safeParse({
+      name,
+      currency: '$',
+      participants: [{ name: 'John' }],
+    })
+    return result.success
+      ? []
+      : result.error.issues
+          .filter((i) => i.path.join('.') === 'name')
+          .map((i) => i.message)
+  }
+
+  it.each([
+    ['empty', ''],
+    ['one space', ' '],
+    ['spaces only', '     '],
+    ['tabs only', '\t\t'],
+    ['no-break spaces only', '  '],
+    ['zero-width spaces only', '​​'],
+    ['one visible character among spaces', '   x'],
+  ])('rejects a name with fewer than two visible characters: %s', (_, name) => {
+    expect(nameIssues(name)).toEqual(['min2'])
+  })
+
+  it.each([
+    ['two characters', 'Jo'],
+    ['an ordinary name', 'Trip to Rome'],
+    ['a name with surrounding spaces', '  Trip  '],
+  ])('accepts %s', (_, name) => {
+    expect(nameIssues(name)).toEqual([])
+  })
+})
